# ORVYN Environment Variables

# Application
APP_ENV=development
APP_NAME=ORVYN
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# PostgreSQL & pgvector
DATABASE_URL=postgresql+asyncpg://orvyn:orvyn_secret@localhost:5432/orvyn
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (OpenAI / Anthropic / Gemini)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Telephony (Twilio / Vapi)
TELEPHONY_PROVIDER=mock  # "mock" | "twilio" | "vapi"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Search APIs (Tavily / SerpAPI / DuckDuckGo)
SEARCH_PROVIDER=duckduckgo  # "duckduckgo" | "tavily"
TAVILY_API_KEY=

# User Settings (Default contact for intervention calls)
DEFAULT_USER_PHONE=+10000000000
DEFAULT_USER_NAME="Engineer"
